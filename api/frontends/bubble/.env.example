# cloudchamber API (pipeline jobs)
VITE_CLOUDCHAMBER_API_BASE=http://localhost:3000
# auth service (Google sign-in)
VITE_AUTH_API_BASE=http://127.0.0.1:6100
# tusd resumable upload endpoint
VITE_TUSD_ENDPOINT=http://localhost:8180/files/
# S3-compatible artifacts bucket (used to derive canonical sourceRef client-side)
VITE_ARTIFACTS_BUCKET=cloudchamber-artifacts
